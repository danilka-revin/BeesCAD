{
  "name": "beescad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BeesCAD — инженерная платформа параметрического 3D-моделирования",
  "author": "BeesCAD contributors",
  "homepage": "https://github.com/danilka-revin/BeesCAD",
  "repository": {
    "type": "git",
    "url": "https://github.com/danilka-revin/BeesCAD.git"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/write-version.mjs && node scripts/precompress.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "npm run build && node scripts/server.mjs",
    "test:smoke": "esbuild test/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --log-level=warning && node node_modules/.cache/smoke.mjs",
    "test:server": "node test/server.mjs",
    "test": "npm run test:smoke && npm run test:server"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
